# Copy to apps/web/.env.local (or repo root .env) for local development.

# --- Demo mode (default) ---
# Leave DATABASE_URL and GitHub OAuth unset to use in-memory seed data.
# The dashboard is fully demoable without Postgres or GitHub.

# --- Postgres (optional) ---
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/shtd

# --- GitHub OAuth (optional) ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Signed session cookie secret (min 32 chars). Required for real OAuth sessions.
AUTH_SECRET=dev-secret-change-me-please-32chars

# Public site URL (used in OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force demo session even if OAuth is configured (1 = yes)
# FORCE_DEMO_AUTH=1
