# Shared env template — copy relevant vars into apps/web/.env.local

# Postgres (optional; omit for in-memory demo store)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/shtd

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback
# AUTH_SECRET=dev-secret-change-me-please-32chars
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# See apps/web/.env.example for the full web dashboard list.
